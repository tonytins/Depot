<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Depot.Interface's tests: most came with the code from VentureOS's Venture.OS.Common.Tests. They read Hudini's
    examples from tests/Fixtures, which depot-render's tests share, beside them as Interface/Fixtures/Hudini.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Depot.Interface.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- xUnit v3 test projects are executables. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../Fixtures/**/*" LinkBase="Interface/Fixtures/Hudini" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Depot.Interface/Depot.Interface.csproj" />
  </ItemGroup>

</Project>
