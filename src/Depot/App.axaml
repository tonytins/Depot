<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Depot.App"
             RequestedThemeVariant="Default">
  <!--
    Depot wears the look it gives new documents, Hudini's depot and depotLight themes: slate and amber, softened
    after Adwaita. The colors are the themes' own; change them together.

    Depot draws with the Venture Design Language's roles (Foundations ▸ Color roles and Type), keyed by the role's
    name, so a control asks for secondaryText, not a color. Fluent's palette below draws Fluent's own controls and
    must agree with the roles; LookTests checks both, and that every role reads on every surface.
  -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="text" Color="#E4E8EE"/>
          <!-- 58%, 50%, and 20% of text, so they're quieter on whatever surface they're over. -->
          <SolidColorBrush x:Key="secondaryText" Color="#94E4E8EE"/>
          <SolidColorBrush x:Key="disabledText" Color="#80E4E8EE"/>
          <SolidColorBrush x:Key="highlightedText" Color="#12151B"/>
          <SolidColorBrush x:Key="accent" Color="#F0BE5A"/>
          <SolidColorBrush x:Key="panel" Color="#1A1E26"/>
          <SolidColorBrush x:Key="inputBackground" Color="#12151B"/>
          <SolidColorBrush x:Key="border" Color="#33E4E8EE"/>
          <!-- The accent mixed 35% into inputBackground, as VentureOS mixes it on dark. -->
          <SolidColorBrush x:Key="selection" Color="#605031"/>
          <!-- Depot's own: the bars above and below the editor and canvas, and behind the canvas. -->
          <SolidColorBrush x:Key="headerBar" Color="#262B34"/>
          <!-- Lighter than Hudini's depot window and its title bar, so a window's edge shows against it. -->
          <SolidColorBrush x:Key="canvasBackground" Color="#30353F"/>
          <SolidColorBrush x:Key="errorText" Color="#EE7B72"/>
          <!-- The States table's hover and press: text at 7% and 16%. -->
          <SolidColorBrush x:Key="hover" Color="#12E4E8EE"/>
          <SolidColorBrush x:Key="pressed" Color="#29E4E8EE"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="text" Color="#333338"/>
          <!-- 70%, 50%, and 20% of text. 70%, not the system's 55%, so small text reaches 4.5 to 1 behind the canvas. -->
          <SolidColorBrush x:Key="secondaryText" Color="#B3333338"/>
          <SolidColorBrush x:Key="disabledText" Color="#80333338"/>
          <SolidColorBrush x:Key="highlightedText" Color="#12151B"/>
          <!-- Amber darkened, so it stands out from white. -->
          <SolidColorBrush x:Key="accent" Color="#B07A0E"/>
          <SolidColorBrush x:Key="panel" Color="#FAFAFB"/>
          <SolidColorBrush x:Key="inputBackground" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="border" Color="#33333338"/>
          <!-- The accent mixed 30% into inputBackground, as VentureOS mixes it on light. -->
          <SolidColorBrush x:Key="selection" Color="#E7D7B7"/>
          <SolidColorBrush x:Key="headerBar" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="canvasBackground" Color="#F2F2F3"/>
          <SolidColorBrush x:Key="errorText" Color="#C01C28"/>
          <SolidColorBrush x:Key="hover" Color="#12333338"/>
          <SolidColorBrush x:Key="pressed" Color="#29333338"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- The type roles, at Depot's sizes: VentureOS's, with caption at Hudini's 12 for the compact inspector. -->
      <x:Double x:Key="captionSize">12</x:Double>
      <x:Double x:Key="bodySize">13</x:Double>
      <x:Double x:Key="titleSize">17</x:Double>
      <x:Double x:Key="largeTitleSize">22</x:Double>
      <!-- Fluent's controls draw their text at body. -->
      <x:Double x:Key="ControlContentThemeFontSize">13</x:Double>

      <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
      <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>

      <!--
        Where the bar is the title bar on Linux, Avalonia draws the window's frame, so the window manager doesn't add
        its own title bar above. The frame keeps its edges for resizing and draws nothing else: the bar holds the
        title and the buttons. From Roundhouse.
      -->
      <ControlTheme x:Key="FrameOnly" TargetType="WindowDrawnDecorations">
        <Setter Property="DefaultTitleBarHeight" Value="42"/>
        <Setter Property="DefaultFrameThickness" Value="4"/>
        <Setter Property="DefaultShadowThickness" Value="0"/>
        <Setter Property="Template">
          <WindowDrawnDecorationsTemplate>
            <WindowDrawnDecorationsContent/>
          </WindowDrawnDecorationsTemplate>
        </Setter>
      </ControlTheme>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <!-- Compact, as Roundhouse is: more of the document fits beside the canvas. -->
    <FluentTheme DensityStyle="Compact">
      <FluentTheme.Palettes>
        <!-- Accent, RegionColor, BaseHigh, and ErrorText are the roles accent, panel, text, and errorText. -->
        <ColorPaletteResources x:Key="Dark"
                               Accent="#F0BE5A"
                               RegionColor="#1A1E26"
                               AltHigh="#1A1E26"
                               AltMediumHigh="#1A1E26"
                               AltMedium="#12151B"
                               AltMediumLow="#12151B"
                               AltLow="#12151B"
                               BaseHigh="#E4E8EE"
                               BaseMediumHigh="#C2C6CC"
                               BaseMedium="#8F939A"
                               BaseMediumLow="#5A5E66"
                               BaseLow="#42464E"
                               ChromeMedium="#262B34"
                               ChromeMediumLow="#262B34"
                               ChromeLow="#1F232B"
                               ChromeHigh="#42464E"
                               ChromeAltLow="#E4E8EE"
                               ListLow="#262B34"
                               ListMedium="#3A4250"
                               ErrorText="#EE7B72"/>
        <ColorPaletteResources x:Key="Light"
                               Accent="#B07A0E"
                               RegionColor="#FAFAFB"
                               AltHigh="#FAFAFB"
                               AltMediumHigh="#FAFAFB"
                               AltMedium="#FFFFFF"
                               AltMediumLow="#FFFFFF"
                               AltLow="#FFFFFF"
                               BaseHigh="#333338"
                               BaseMediumHigh="#4F4F54"
                               BaseMedium="#737376"
                               BaseMediumLow="#A3A3A6"
                               BaseLow="#D2D2D4"
                               ChromeMedium="#FFFFFF"
                               ChromeMediumLow="#FFFFFF"
                               ChromeLow="#F2F2F3"
                               ChromeHigh="#D2D2D4"
                               ChromeAltLow="#333338"
                               ListLow="#EBEBED"
                               ListMedium="#DADADC"
                               ErrorText="#C01C28"/>
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml"/>

    <!-- The title bar, which holds the toolbar, and the status bar: a step from the window, as Hudini's title bar is. -->
    <Style Selector=":is(Border).titleBar">
      <Setter Property="Background" Value="{DynamicResource headerBar}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource border}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
    <Style Selector="TextBlock.barTitle">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <!-- The bar's buttons are flat on it, and only show themselves under the pointer, as the States table has it. -->
    <Style Selector=":is(Border).titleBar :is(Button).bar">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="10,5"/>
    </Style>
    <Style Selector=":is(Border).titleBar :is(Button).bar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource hover}"/>
    </Style>
    <Style Selector=":is(Border).titleBar :is(Button).bar:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource pressed}"/>
    </Style>
    <Style Selector=":is(Border).titleBar :is(Button).bar:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <!-- Windows-style window buttons: the bar's full height, square, with a red close under the pointer. -->
    <Style Selector="Button.caption">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="41"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.caption Path">
      <Setter Property="Stroke" Value="{DynamicResource text}"/>
    </Style>
    <Style Selector="Button.caption:disabled Path">
      <Setter Property="Stroke" Value="{DynamicResource disabledText}"/>
    </Style>
    <Style Selector="Button.caption:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource hover}"/>
    </Style>
    <Style Selector="Button.caption:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource pressed}"/>
    </Style>
    <!-- Windows 11's close red, an exact color, the same on light and dark. -->
    <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#C42B1C"/>
    </Style>
    <Style Selector="Button.caption.close:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#A32417"/>
    </Style>
    <Style Selector="Button.caption.close:pointerover Path">
      <Setter Property="Stroke" Value="White"/>
    </Style>

    <Style Selector="Border.bar">
      <Setter Property="Background" Value="{DynamicResource headerBar}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource border}"/>
    </Style>
    <Style Selector="GridSplitter">
      <Setter Property="Background" Value="{DynamicResource border}"/>
    </Style>

    <!-- Text in the roles. A TextBlock takes one color class and, if it isn't body, one size class. -->
    <Style Selector="TextBlock.secondary">
      <Setter Property="Foreground" Value="{DynamicResource secondaryText}"/>
    </Style>
    <Style Selector="TextBlock.problem">
      <Setter Property="Foreground" Value="{DynamicResource errorText}"/>
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="{DynamicResource captionSize}"/>
    </Style>
    <!-- A pane's or a group's heading: quieter than what it heads, so the eye goes to the content. -->
    <Style Selector="TextBlock.heading">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource secondaryText}"/>
    </Style>

    <!-- List items in the States table's terms: a faint tint under the pointer, a stronger one pressed, and the
         selection role behind the chosen one. -->
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource hover}"/>
    </Style>
    <Style Selector="ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource pressed}"/>
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource selection}"/>
      <Setter Property="Foreground" Value="{DynamicResource text}"/>
    </Style>

    <!-- A button that's turned off says so in disabledText, as the States table has it. -->
    <Style Selector=":is(Button):disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource disabledText}"/>
    </Style>

    <!-- The inspector's short fields, as an IDE's property grid has, so more of an element fits without scrolling. -->
    <Style Selector=":is(TemplatedControl).field">
      <Setter Property="Height" Value="26"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="FontSize" Value="{DynamicResource captionSize}"/>
      <Setter Property="Padding" Value="6,0"/>
    </Style>
  </Application.Styles>
</Application>
