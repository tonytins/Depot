<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Depot, a designer for the UIScript documents Hudini's games read. Its shell comes from Roundhouse, VentureOS's
    IDE; its canvas will be drawn by depot-render, with Hudini itself, so what's designed is what the game draws.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Depot</AssemblyName>
    <RootNamespace>Depot</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!-- At Roundhouse's versions, so its designer comes across unchanged. -->
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <!-- The text beside the canvas, with XML highlighting. -->
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="AvaloniaEdit.TextMate" Version="12.0.0" />
    <!-- Depot's own words, in uitext; Depot.Interface uses it for documents' string tables, at the same version. -->
    <PackageReference Include="CSTNet" Version="2.1.200" />
  </ItemGroup>

  <ItemGroup>
    <!-- Depot's words, read beside the app so a label changes without a rebuild. -->
    <None Include="uitext\**\*.cst" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Depot.Interface/Depot.Interface.csproj" />
  </ItemGroup>

</Project>
