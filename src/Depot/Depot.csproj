<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Depot, a designer for the UIScript documents Hudini's games read. Its shell comes from Roundhouse, VentureOS's
    IDE; its canvas will be drawn by depot-render, with Hudini itself, so what's designed is what the game draws.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Depot</AssemblyName>
    <RootNamespace>Depot</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!-- At Roundhouse's versions, so its designer comes across unchanged. -->
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Depot.Interface/Depot.Interface.csproj" />
  </ItemGroup>

</Project>
