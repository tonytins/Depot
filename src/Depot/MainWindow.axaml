<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="https://github.com/avaloniaui/avaloniaedit"
        xmlns:designer="using:Depot.Designer"
        x:Class="Depot.MainWindow"
        Title="Depot"
        Width="1280" Height="760"
        MinWidth="800" MinHeight="440">
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="bar" BorderThickness="0,0,0,1" Padding="8,6">
      <DockPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button x:Name="OpenButton" Content="Open…" HotKey="Ctrl+O" ToolTip.Tip="Open a .uix or .uis document (Ctrl+O)"/>
          <Button x:Name="SaveButton" Content="Save" HotKey="Ctrl+S" IsEnabled="False" ToolTip.Tip="Save the document (Ctrl+S)"/>
          <Border Width="12"/>
          <Button x:Name="UndoButton" Content="Undo" IsEnabled="False" ToolTip.Tip="Undo the last change, typed or designed (Ctrl+Z)"/>
          <Button x:Name="RedoButton" Content="Redo" IsEnabled="False" ToolTip.Tip="Redo what was undone (Ctrl+Shift+Z)"/>
          <Border Width="12"/>
          <Button x:Name="AddButton" Content="Add ▾" IsEnabled="False" ToolTip.Tip="Add a control or a part of the window"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <TextBlock Text="Look" VerticalAlignment="Center" Opacity="0.75"/>
          <ComboBox x:Name="LookPicker" MinWidth="160" ToolTip.Tip="The Hudini theme the canvas draws in"/>
          <Button x:Name="AppearanceButton" Content="No appearance ▾"
                  ToolTip.Tip="The Hudini appearance documents are read with, as a game reads its windows"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Classes="bar" BorderThickness="0,1,0,0" Padding="10,5">
      <TextBlock x:Name="Status" TextWrapping="Wrap" Text="Open a document to see it as Hudini draws it."/>
    </Border>
    <Grid ColumnDefinitions="2*,4,3*,4,280">
      <ae:TextEditor x:Name="Editor"
                     Grid.Column="0"
                     FontFamily="Cascadia Code,Fira Code,JetBrains Mono,DejaVu Sans Mono,Menlo,Consolas,monospace"
                     FontSize="13"
                     ShowLineNumbers="True"
                     IsReadOnly="True"
                     Padding="4,4,0,0"/>
      <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
      <Panel Grid.Column="2" Background="{DynamicResource SystemControlBackgroundChromeLowBrush}">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <!-- The picture and, over it, the selection; the host takes the pointer and the keyboard. -->
          <Panel x:Name="CanvasHost" Margin="24" Focusable="True" Background="Transparent"
                 HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image x:Name="Canvas" Stretch="None" RenderOptions.BitmapInterpolationMode="None"/>
            <Canvas x:Name="SelectionLayer" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"/>
          </Panel>
        </ScrollViewer>
        <TextBlock x:Name="CanvasMessage" Margin="32" TextWrapping="Wrap" TextAlignment="Center"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.75"
                   Text="No document open"/>
      </Panel>
      <GridSplitter Grid.Column="3" ResizeDirection="Columns" Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
      <Grid Grid.Column="4" RowDefinitions="Auto,2*,Auto,3*">
        <TextBlock Grid.Row="0" Text="Outline" FontWeight="SemiBold" Margin="10,8,10,4" Opacity="0.75"/>
        <ListBox x:Name="Outline" Grid.Row="1" Margin="4,0" FontSize="12"/>
        <TextBlock Grid.Row="2" Text="Inspector" FontWeight="SemiBold" Margin="10,10,10,4" Opacity="0.75"/>
        <ScrollViewer Grid.Row="3" Padding="10,0,10,10">
          <StackPanel>
            <TextBlock x:Name="InspectorHint" TextWrapping="Wrap" Opacity="0.6" FontSize="12" Text="Select an element to see its attributes."/>
            <designer:InspectorPanel x:Name="InspectorView"/>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
