<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="https://github.com/avaloniaui/avaloniaedit"
        xmlns:designer="using:Depot.Designer"
        xmlns:local="using:Depot"
        x:Class="Depot.MainWindow"
        Title="Depot"
        Width="1280" Height="760"
        MinWidth="800" MinHeight="440">
  <DockPanel>
    <!-- The title bar, which is the toolbar; where the desktop allows, it's the window's own title bar. -->
    <local:WindowTitleBar x:Name="TitleBar" DockPanel.Dock="Top">
      <local:WindowTitleBar.Start>
        <!-- The menus, where the desktop has no global menu bar to show them in. -->
        <Button x:Name="MenuButton" Classes="bar" Content="☰" FontSize="16" ToolTip.Tip="Menu"/>
        <Button x:Name="UndoButton" Classes="bar" Content="Undo" IsEnabled="False" ToolTip.Tip="Undo the last change, typed or designed (Ctrl+Z)"/>
        <Button x:Name="RedoButton" Classes="bar" Content="Redo" IsEnabled="False" ToolTip.Tip="Redo what was undone (Ctrl+Shift+Z)"/>
        <Border Width="8"/>
        <Button x:Name="AddButton" Classes="bar" Content="Add ▾" IsEnabled="False" ToolTip.Tip="Add a control or a part of the window"/>
      </local:WindowTitleBar.Start>
      <local:WindowTitleBar.End>
        <ComboBox x:Name="LookPicker" MinWidth="140" VerticalAlignment="Center" ToolTip.Tip="The Hudini theme the canvas draws in"/>
        <Button x:Name="AppearanceButton" Classes="bar" Content="No appearance ▾"
                ToolTip.Tip="The Hudini appearance documents are read with, as a game reads its windows"/>
      </local:WindowTitleBar.End>
    </local:WindowTitleBar>
    <Border DockPanel.Dock="Bottom" Classes="bar" BorderThickness="0,1,0,0" Padding="10,5">
      <TextBlock x:Name="Status" TextWrapping="Wrap" Text="Open a document to see it as Hudini draws it."/>
    </Border>
    <Grid ColumnDefinitions="2*,4,3*,4,280">
      <ae:TextEditor x:Name="Editor"
                     Grid.Column="0"
                     FontFamily="Cascadia Code,Fira Code,JetBrains Mono,DejaVu Sans Mono,Menlo,Consolas,monospace"
                     FontSize="13"
                     ShowLineNumbers="True"
                     IsReadOnly="True"
                     Padding="4,4,0,0"/>
      <GridSplitter Grid.Column="1" ResizeDirection="Columns"/>
      <Panel Grid.Column="2" Background="{DynamicResource canvasBackground}">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <!-- The picture and, over it, the selection; the host takes the pointer and the keyboard. -->
          <Panel x:Name="CanvasHost" Margin="24" Focusable="True" Background="Transparent"
                 HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image x:Name="Canvas" Stretch="None" RenderOptions.BitmapInterpolationMode="None"/>
            <Canvas x:Name="SelectionLayer" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"/>
          </Panel>
        </ScrollViewer>
        <TextBlock x:Name="CanvasMessage" Classes="secondary" Margin="32" TextWrapping="Wrap" TextAlignment="Center"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Text="No document open"/>
      </Panel>
      <GridSplitter Grid.Column="3" ResizeDirection="Columns"/>
      <Grid Grid.Column="4" RowDefinitions="Auto,2*,Auto,3*">
        <TextBlock Grid.Row="0" Text="Outline" Classes="heading" Margin="10,8,10,4"/>
        <ListBox x:Name="Outline" Grid.Row="1" Margin="4,0" FontSize="{DynamicResource captionSize}"/>
        <TextBlock Grid.Row="2" Text="Inspector" Classes="heading" Margin="10,10,10,4"/>
        <ScrollViewer Grid.Row="3" Padding="10,0,10,10">
          <StackPanel>
            <TextBlock x:Name="InspectorHint" Classes="secondary caption" TextWrapping="Wrap" Text="Select an element to see its attributes."/>
            <designer:InspectorPanel x:Name="InspectorView"/>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
